# ---------------------------------------------------------------------------
# This template contains only required options.
# See docs/system/configuration.md for more options.
# ---------------------------------------------------------------------------

# random secret key, use for example `base64 /dev/urandom | head -c50` to generate one
SECRET_KEY=

# your default timezone See https://timezonedb.com/time-zones for a list of timezones
TZ=Europe/Berlin

# allowed hosts (see documentation), must be set to your hostname(s)
ALLOWED_HOSTS=recipes.mydomain.com

# add only a database password if you want to run with the default postgres, otherwise change settings accordingly
DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=db_recipes
POSTGRES_DB=djangodb
POSTGRES_PORT=5432
POSTGRES_USER=djangouser
POSTGRES_PASSWORD=

# Optional: keep Walmart credentials on your own server-side broker.
# Table never exposes these values to the browser. Leave blank to disable shopping handoff.
TABLE_SHOPPING_BROKER_URL=
TABLE_SHOPPING_BROKER_TOKEN=
# Path on the broker that accepts {provider, action, space_id, data} JSON requests.
TABLE_SHOPPING_BROKER_PATH=/v1/table/shopping
# Comma-separated capabilities returned to the Table UI.
TABLE_SHOPPING_BROKER_CAPABILITIES=search,cart,handoff
